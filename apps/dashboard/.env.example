# Copy to .env.local for `npm run dev`.
# Go API base URL (no trailing slash, no /v1).
API_PROXY_TARGET=https://aegispay.fly.dev
# Same value as the API's TRUSTED_PROXY_SECRET, so per-IP rate limits see the
# browser address. Optional for local development.
TRUSTED_PROXY_SECRET=
# Header your hosting edge sets with the client address, e.g.
# x-nf-client-connection-ip (Netlify) or cf-connecting-ip (Cloudflare).
CLIENT_IP_HEADER=
