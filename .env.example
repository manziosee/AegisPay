# Local development only. Generate unique values with: ./scripts/dev-secrets.sh
POSTGRES_DB=aegispay
POSTGRES_USER=aegispay_admin
POSTGRES_PASSWORD=replace-admin-secret
APP_DB_USER=aegispay_app
APP_DB_PASSWORD=replace-app-secret
REDIS_PASSWORD=replace-redis-secret
API_PORT=18080
AEGIS_API_KEY=replace-with-generated-api-key
# Encrypts webhook signing secrets and MFA seeds. Comma-separated id:hex pairs;
# the first key encrypts new secrets, every listed key can decrypt. To rotate,
# put a new key first and remove the old one after the API logs that no
# secrets remain under it. WEBHOOK_ENCRYPTION_KEY (single key) is still read
# for installations created before key versioning.
ENCRYPTION_KEYS=k1:replace-with-64-hex-character-key
# Shared by the dashboard and API so per-IP rate limits see the browser's
# address instead of the dashboard server's.
TRUSTED_PROXY_SECRET=replace-with-64-hex-character-secret
AEGIS_ORGANIZATION_ID=org_sandbox

### API KEYS (all free, no card)
# Browser push: generate with `npx web-push generate-vapid-keys` (no account).
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:you@example.com
# Email via Brevo (free 300/day): https://www.brevo.com -> Settings -> SMTP & API.
BREVO_API_KEY=
EMAIL_FROM=you@example.com
EMAIL_FROM_NAME=AegisPay
# Optional Telegram approvals: create a bot with @BotFather.
TELEGRAM_BOT_TOKEN=
# Passkeys (WebAuthn) settings.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_ORIGINS=http://localhost:3000

# --- Money, banks and exchange rates (all free; sandbox/test keys only) -----
# Exchange rates need NO key: open.er-api.com (166 currencies incl. RWF, KES,
# NGN) plus the European Central Bank via api.frankfurter.app.
# Optional higher-limit rates (free 1,000 requests/month, key, no card):
#   https://openexchangerates.org/signup/free
OPEN_EXCHANGE_RATES_APP_ID=

# Payment providers (test/sandbox keys move no real money). Fill in only
# the ones you want to connect first.
# Stripe test mode (cards, global): https://dashboard.stripe.com/register
STRIPE_TEST_SECRET_KEY=
# Flutterwave test keys (Africa, cards + mobile money): https://developer.flutterwave.com
FLUTTERWAVE_TEST_SECRET_KEY=
FLUTTERWAVE_TEST_PUBLIC_KEY=
# M-Pesa Daraja sandbox (Kenya): https://developer.safaricom.co.ke
MPESA_SANDBOX_CONSUMER_KEY=
MPESA_SANDBOX_CONSUMER_SECRET=
# MTN MoMo sandbox (many African countries): https://momodeveloper.mtn.com
MTN_MOMO_COLLECTION_SUBSCRIPTION_KEY=
MTN_MOMO_DISBURSEMENT_SUBSCRIPTION_KEY=

# Bank account data (automatic statements, no CSV upload)
# TrueLayer sandbox (UK/EU bank data, free): https://console.truelayer.com
# (GoCardless Bank Account Data has closed new sign-ups.)
TRUELAYER_SANDBOX_CLIENT_ID=
TRUELAYER_SANDBOX_CLIENT_SECRET=
# Plaid sandbox (US/Canada/Europe test banks): https://dashboard.plaid.com/signup
PLAID_CLIENT_ID=
PLAID_SANDBOX_SECRET=
