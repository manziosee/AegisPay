# Local development only. Generate unique values with: ./scripts/dev-secrets.sh
POSTGRES_DB=aegispay
POSTGRES_USER=aegispay_admin
POSTGRES_PASSWORD=replace-admin-secret
APP_DB_USER=aegispay_app
APP_DB_PASSWORD=replace-app-secret
REDIS_PASSWORD=replace-redis-secret
API_PORT=18080
AEGIS_API_KEY=replace-with-generated-api-key
# Encrypts webhook signing secrets and MFA seeds. Comma-separated id:hex pairs;
# the first key encrypts new secrets, every listed key can decrypt. To rotate,
# put a new key first and remove the old one after the API logs that no
# secrets remain under it. WEBHOOK_ENCRYPTION_KEY (single key) is still read
# for installations created before key versioning.
ENCRYPTION_KEYS=k1:replace-with-64-hex-character-key
# Shared by the dashboard and API so per-IP rate limits see the browser's
# address instead of the dashboard server's.
TRUSTED_PROXY_SECRET=replace-with-64-hex-character-secret
AEGIS_ORGANIZATION_ID=org_sandbox
